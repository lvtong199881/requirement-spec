# 依赖与运行产物
node_modules/
*.log
.DS_Store

# Figma OAuth 凭据（由 mcp-remote 存放在 ~/.mcp-auth，永远不会出现在这里；
# 万一误拷进目录也不许提交）
*_tokens.json
_client_info.json
.mcp-auth/

# 出稿中间产物（可随时从 design-spec.json 重新派生）
tmp/
.out/
*.tmp

# 遥测数据：默认写进仓库但由脚本自动加入本 ignore，只留本地；
# 只有把配置 commit 设为 true 才会随 git 提交（含明文需求标识与作者名，提交前须确认）
docs/requirements/.telemetry/
