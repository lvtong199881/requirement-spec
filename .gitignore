# 依赖与运行产物
node_modules/
*.log
.DS_Store

# Figma OAuth 凭据（由 mcp-remote 存放在 ~/.mcp-auth，永远不会出现在这里；
# 万一误拷进目录也不许提交）
*_tokens.json
_client_info.json
.mcp-auth/

# 出稿中间产物（可随时从 design-spec.json 重新派生）
tmp/
.out/
*.tmp

# 遥测数据默认随 git 提交（团队共享）。想让数据只留本地，取消下面这行注释，
# 并把配置 commit 设为 false（此时明文不会进版本历史）。
# docs/requirements/.telemetry/
